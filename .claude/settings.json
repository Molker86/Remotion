{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx remotion:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)"
    ]
  }
}
